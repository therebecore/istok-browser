    <!-- ADR-063: the page sent the viewer to an address with a broken certificate.
         The page itself is alive and stays; this is the whole explanation. -->
    <string name="quiet_ssl">%1$s did not open: invalid certificate</string>
    <!-- B-180: shown right under the certificate error. The viewer goes looking
         for a switch at this exact moment, and the only security-looking one
         ("warn about dangerous sites") has nothing to do with certificates. -->
    <string name="ssl_not_a_setting">Certificate checking cannot be turned off and does not depend on the settings: the "dangerous sites" switch is about a list of addresses, not about certificates.</string>

    <!-- Незащищённое соединение -->
    <string name="http_title">Connection is not secure</string>
    <string name="http_message">This site sends data in the clear. Everything you type or read on it is visible to anyone with access to the network.</string>
    <string name="http_action">Open anyway</string>

    <!-- Ошибки сертификата -->
    <string name="err_ssl_title">The site certificate is not valid</string>
    <string name="ssl_expired">The certificate has expired. A site whose owner simply forgot about it looks exactly like an attempt to impersonate it.</string>
    <string name="ssl_idmismatch">The certificate was issued for a different name. The connection may be intercepted.</string>
    <string name="ssl_untrusted">The certificate was issued by an unknown certificate authority.</string>
    <string name="ssl_notyetvalid">The certificate is not valid yet. Check the date and time on the TV.</string>
    <string name="ssl_other">The certificate check did not pass.</string>

    <!-- Сетевая ошибка -->
    <string name="err_net_title">Could not open the page</string>
    <string name="err_net_message">The site is not responding, or there is no network connection.</string>

