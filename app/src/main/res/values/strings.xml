    <string name="err_spoof_title">Suspicious address</string>
    <string name="err_spoof_message">The address has another site name in front of the @ sign - that is how a jump to a foreign server is disguised. The browser does not open such links. The link really leads here:</string>

    <!-- Заблокированная схема -->
    <string name="err_lan_title">Home network is not allowed</string>
    <string name="err_lan_message">This address belongs to a device in your home network, and access to it is turned off. Turn on the local network permission for the browser in the TV settings, under Apps.</string>
    <string name="err_blocked_title">Link blocked</string>
    <string name="err_blocked_message">The link leads to another app, not to a web page. The browser does not follow such links.</string>

