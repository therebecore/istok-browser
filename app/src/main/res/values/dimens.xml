<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Высота панели навигации. Значение живёт здесь, а не в разметке: на него
         опирается и отступ WebView сверху, и они обязаны совпадать - иначе панель
         либо перекроет страницу, либо оставит под собой полосу фона. -->
    <dimen name="panel_height">72dp</dimen>

    <!-- Площадь попадания курсором, а не размер иконки. -->
    <dimen name="panel_button">56dp</dimen>

    <!-- Полоса загрузки прижата к нижней кромке панели: 72 - 3. -->
    <dimen name="panel_progress_top">69dp</dimen>

    <!-- Меню шире самого длинного пункта: узкая полоска на телевизоре читается хуже,
         а целиться в неё курсором труднее. -->
    <dimen name="menu_width">280dp</dimen>

    <!-- Клавиша экранной клавиатуры. Ширины у неё нет: ряд делится между клавишами
         долями, иначе короткий ряд оставлял бы пустые поля по краям (ADR-034). -->
    <dimen name="key_height">48dp</dimen>
    <dimen name="key_margin">2dp</dimen>

    <!-- Поле по краям клавиатуры: без него крайние клавиши упираются в рамку
         телевизора, а на части экранов часть их площади уходит за пределы
         видимой области (overscan). -->
    <dimen name="key_edge">12dp</dimen>

    <!-- Боковые колонки: слева работа с текстом целиком, справа правка. Шире буквенной
         клавиши в полтора раза - как на настоящей клавиатуре, где «стереть» и «ввод»
         крупнее букв, и по той же причине: попадать в них надо чаще и вернее. -->
    <dimen name="key_side_width">84dp</dimen>

</resources>
