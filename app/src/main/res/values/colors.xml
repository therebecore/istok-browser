<?xml version="1.0" encoding="utf-8"?>
<resources>

    <color name="panel_background">#FF15181C</color>
    <color name="panel_button_pressed">#FF2C3138</color>
    <color name="panel_text">#FFE8EAED</color>

    <!-- Адрес за именем хоста: путь и параметры не должны перетягивать взгляд с домена -->
    <color name="panel_hint">#FF98A1AB</color>

    <!-- Затемнение под открытым меню: видно, что нажатия сейчас принимает только меню -->
    <color name="menu_scrim">#99000000</color>

    <!--
      Синий браузера, выбран пользователем 2026-08-17 и утверждён 2026-08-20 (ADR-052).
      Причина синего названа им же: его различают почти все виды дальтонизма,
      в отличие от зелёного и красного.

      Тонов два, и это один и тот же синий разной светлоты:
      accent      - заливка. Наведение курсора, клавиша «Ввод», выделенная площадь.
                    Светлый текст на нём читается (контраст около 9:1).
      accent_line - тонкий синий. Рамка, подчёркивание, значок, курсор, значение
                    настройки. На тёмном фоне заливочный тон тонкой линией не виден
                    вовсе (контраст 2:1), поэтому линии и текст берут светлый тон.
    -->
    <color name="accent">#FF2C4A73</color>
    <color name="accent_line">#FF6BA6F0</color>

    <!-- Клавиши экранной клавиатуры. Своя заливка, а не прозрачный фон кнопок панели:
         клавиш много, и без границ они сливаются в сплошное поле знаков. -->
    <color name="key_face">#FF262A31</color>
    <color name="key_pressed">#FF3A4048</color>
    <!-- Выбранная клавиша в режиме пульта: цвет заметен с трёх метров. Средний тон
         того же синего - ярче заливки наведения, темнее тонких линий, поэтому три
         состояния клавиатуры (наведён, выбран, «Ввод») различаются между собой. -->
    <color name="key_selected">#FF2E6BE6</color>

</resources>
