<?xml version="1.0" encoding="utf-8"?>
<!-- Фон кнопок панели. Нажатие обязано быть видно: курсором пользователь целится
     менее точно, чем мышью, и без отклика непонятно, попал он по кнопке или мимо.
     Ripple не используется - это лишняя анимация на каждый кадр там, где хватает
     смены цвета. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Подсветка нажатия скруглена на те же 6dp, что клавиши и кнопки диалогов:
         квадратное пятно внутри скруглённого меню читалось заплаткой. -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/panel_button_pressed" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
