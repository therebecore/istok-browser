<?xml version="1.0" encoding="utf-8"?>
<!-- Фон кнопок под полем переименования. Своя заливка и рамка, а не прозрачный фон
     кнопок панели: две кнопки рядом на общей плашке сливались в одну полосу с двумя
     надписями, и было непонятно, где кончается одна и начинается другая. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/key_pressed" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <!-- Наведение курсора. Своим состоянием, а не `state_hovered`: курсор шлёт
         в наши View обычные касания, событий наведения платформы тут нет вовсе. -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/key_pressed" />
            <stroke android:width="2dp" android:color="@color/accent_line" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/key_face" />
            <stroke android:width="1dp" android:color="@color/panel_button_pressed" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
