<?xml version="1.0" encoding="utf-8"?>
<!--
    ADR-011. Cleartext (http) разрешён на уровне платформы намеренно, но это НЕ значит,
    что http открывается свободно: решение перенесено в код приложения, где оно
    принимается по каждому домену отдельно и только после явного подтверждения
    пользователя (BrowserWebViewClient). Платформенный запрет здесь невозможен -
    он не различает подтверждённые и неподтверждённые домены.

    Доверяем только системным сертификатам. src="user" не добавляется: пользовательский
    сертификат, подсунутый через профиль, - это готовый MITM на весь трафик браузера.

    Certificate pinning не применяется осознанно: мы браузер и ходим на произвольные домены.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
