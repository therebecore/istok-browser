<?xml version="1.0" encoding="utf-8"?>
<!--
    Требование D-3 из docs/SECURITY.md.

    android:allowBackup="false" отключает облачный бэкап и adb backup, но на Android 12
    и выше он не влияет на перенос данных между устройствами. Без секции device-transfer
    при штатной миграции на новую приставку уехали бы история посещений, cookies
    и хранилище WebView - ровно то, что D-3 обязано исключить.

    Здесь запрещено и то и другое: приложение не переносит никакие свои данные.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
